# Server-only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional: defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Abuse protection (analyses per device per day / across the whole app per day)
ANALYSES_PER_DEVICE_PER_DAY=15
ANALYSES_GLOBAL_PER_DAY=300

# Set to 1 to return clearly-labelled SAMPLE plans without calling the AI (local UI testing only)
MOCK_AI=
